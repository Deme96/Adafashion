# ====================================
# DATABASE CONFIGURATION (Local Development)
# ====================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adafashion

# ====================================
# ADMIN CREDENTIALS
# ====================================
ADMIN_EMAIL=admin@adafashion.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Administrador AdaFashion

# ====================================
# SERVER CONFIGURATION
# ====================================
NODE_ENV=development
PORT=3001
SERVER_URL=http://localhost:3001

# ====================================
# CLIENT CONFIGURATION
# ====================================
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=AdaFashion

# ====================================
# CORS - Allow external device access
# ====================================
# Para desenvolvimento local com dispositivos na rede:
# CORS_ORIGIN=*

# Para restringir a IP específico:
# CORS_ORIGIN=http://192.168.1.100:3000

# ====================================
# OPTIONAL - Session Security
# ====================================
# SESSION_SECRET=seu_super_secret_session_key_aqui
