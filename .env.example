# ====================================
# DATABASE CONFIGURATION (Local)
# ====================================
# Para desenvolvimento local com PhpMyAdmin
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adafashion

# ====================================
# DATABASE CONFIGURATION (Infinity Free / Production)
# ====================================
# Para produção no Vercel com Infinity Free
# DB_HOST=sql200.infinityfree.com
# DB_PORT=3306
# DB_USER=if0_42433124
# DB_PASSWORD=Nademe1001920
# DB_NAME=if0_42433124_adafashion

# ====================================
# ADMIN CREDENTIALS
# ====================================
# Credenciais do administrador (acessíveis de dispositivos externos)
ADMIN_EMAIL=admin@adafashion.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Administrador AdaFashion

# ====================================
# SERVER CONFIGURATION
# ====================================
NODE_ENV=development
PORT=3001
SERVER_URL=http://localhost:3001

# ====================================
# CLIENT CONFIGURATION
# ====================================
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=AdaFashion

# ====================================
# EXTERNAL API KEYS (Opcional)
# ====================================
# Stripe
# VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ====================================
# SESSION & SECURITY
# ====================================
# Session secret para JWT/Sessions
SESSION_SECRET=seu_super_secret_session_key_aqui

# ====================================
# CORS & EXTERNAL ACCESS
# ====================================
# Permitir acesso de dispositivos externos
CORS_ORIGIN=*
# Ou especificar domínios: CORS_ORIGIN=http://localhost:3000,https://adafashion.vercel.app
